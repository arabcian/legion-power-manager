/*
 * 49-legion-power-manager.rules
 *
 * Grants the Legion Power Manager actions without a password prompt to a
 * member of `wheel` sitting at the machine (local + active session);
 * everyone else -- SSH, another seat, a fast-user-switched session, service
 * accounts -- gets auth_admin.
 *
 * Why a .rules file rather than only <allow_active> in the .policy:
 *
 *   - The .policy defaults are only consulted when no rule matches, and some
 *     distributions ship rules of their own (50-default.rules, vendor
 *     packages) that match first and force auth_admin_keep for anything run
 *     through org.freedesktop.policykit.exec. A 49-* file sorts ahead of them.
 *
 *   - It also covers the generic org.freedesktop.policykit.exec fallback
 *     pkexec uses when it cannot match a helper to a pinned action -- matched
 *     here only for the exact helper paths below.
 *
 * Scope: only the fixed programs under @LIBEXEC@/, which install.sh and the
 * ebuild create root:root 0755 (0700 for the nvcurve helper). A non-root
 * user cannot add or alter a file there. The helpers re-validate every
 * request themselves (fixed target paths, allowlisted sysfs shapes, realpath
 * containment, ranges re-read live from the kernel), so the prompt is not
 * what keeps a bad value out.
 *
 * The .policy defaults are auth_admin_keep: if this file is missing or not
 * loaded, nobody gets a silent grant.
 *
 * Distributions without a `wheel` group (Debian/Ubuntu use `sudo`): add
 * `|| subject.isInGroup("sudo")` to the condition below.
 */

// Only a local, active session of a wheel member is granted silently;
// everyone else (SSH, other seats, service accounts) gets auth_admin.
var HELPERS = ["fwattr-helper", "legion-profile-helper", "ryzen-co-helper",
               "tune-helper", "nvcurve-root-helper", "intel-uv-helper", "legion-gpu-helper"].map(function (h) {
    return "@LIBEXEC@/" + h;
});

polkit.addRule(function (action, subject) {
    var ours = action.id.indexOf("com.legion-power-manager.") === 0 ||
        (action.id === "org.freedesktop.policykit.exec" &&
         HELPERS.indexOf(action.lookup("program")) >= 0);
    if (!ours) { return; }
    if (subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.AUTH_ADMIN;
});
