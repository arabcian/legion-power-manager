<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>legion-power-manager</vendor>
  <!-- Nine Rust root helpers, each pinned by exec.path; installed root:root 0755
       (nvcurve-root-helper 0700) under /usr/libexec/legion-power-manager.
       The password-less grant (wheel, local active session) comes only from
       /etc/polkit-1/rules.d/49-legion-power-manager.rules; the defaults below
       are the safe fallback when that file is absent.
       com.legion-power-manager.firmware.write is never granted silently: it
       covers changes that persist in firmware (BIOS memory timings, BIOS CPU OC,
       GPU MUX mode) and asks for the administrator password every time. -->
  <action id="com.legion-power-manager.fwattr.write">
    <description>Write a firmware_attributes sysfs value</description>
    <description xml:lang="tr">Bir firmware_attributes sysfs değerini yaz</description>
    <message>Authentication is required to write a firmware attribute value</message>
    <message xml:lang="tr">Bir firmware özniteliği değerini yazmak için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/fwattr-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.legion-power-manager.nvcurve.set-params">
    <description>Apply NVIDIA GPU V/F curve settings via Legion Power Manager</description>
    <description xml:lang="tr">Legion Power Manager üzerinden NVIDIA GPU V/F eğrisi ayarlarını uygula</description>
    <message>Administrator authentication required (NVIDIA curve optimizer)</message>
    <message xml:lang="tr">Yönetici kimlik doğrulaması gerekiyor (NVIDIA eğri optimizasyonu)</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/nvcurve-root-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.legion-power-manager.ryzen.set-curve">
    <description>Apply RyzenAdj Curve Optimizer values via Legion Power Manager</description>
    <description xml:lang="tr">Legion Power Manager üzerinden RyzenAdj Curve Optimizer değerlerini uygula</description>
    <message>Authentication is required to change the CPU Curve Optimizer voltage offsets</message>
    <message xml:lang="tr">CPU Curve Optimizer voltaj offsetlerini değiştirmek için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/ryzen-co-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.legion-power-manager.intel.undervolt">
    <description>Apply Intel CPU voltage offsets and power limits via Legion Power Manager</description>
    <description xml:lang="tr">Legion Power Manager üzerinden Intel CPU voltaj offsetlerini ve güç limitlerini uygula</description>
    <message>Authentication is required to change the CPU voltage offsets (MSR access)</message>
    <message xml:lang="tr">CPU voltaj offsetlerini değiştirmek için kimlik doğrulama gerekiyor (MSR erişimi)</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/intel-uv-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.legion-power-manager.gpu.power">
    <description>Set experimental GPU power limits via Legion Power Manager</description>
    <description xml:lang="tr">Legion Power Manager ile deneysel GPU güç limitlerini ayarla</description>
    <message>Authentication is required to change the GPU power ceiling (EC table)</message>
    <message xml:lang="tr">GPU güç tavanını değiştirmek için kimlik doğrulama gerekiyor (EC tablosu)</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/legion-gpu-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.legion-power-manager.profile.set">
    <description>Change the ACPI platform power profile</description>
    <description xml:lang="tr">ACPI platform güç profilini değiştir</description>
    <message>Authentication is required to change the laptop power profile</message>
    <message xml:lang="tr">Dizüstü bilgisayarın güç profilini değiştirmek için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/legion-profile-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.legion-power-manager.tune.apply">
    <description>Apply or restore system tuning values via Legion Power Manager</description>
    <description xml:lang="tr">Legion Power Manager üzerinden sistem optimizasyon değerlerini uygula veya geri yükle</description>
    <message>Authentication is required to change kernel tuning settings</message>
    <message xml:lang="tr">Çekirdek optimizasyon ayarlarını değiştirmek için kimlik doğrulama gerekiyor</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/tune-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.legion-power-manager.firmware.write">
    <description>Change firmware settings that persist across reboots (memory timings, CPU overclocking, GPU mode)</description>
    <description xml:lang="tr">Yeniden başlatmadan sonra da kalan firmware ayarlarını değiştir (bellek zamanlamaları, CPU hız aşırtma, GPU modu)</description>
    <message>Authentication is required to change firmware settings that take effect at the next boot. Wrong values can keep the laptop from starting.</message>
    <message xml:lang="tr">Bir sonraki açılışta etkin olacak firmware ayarlarını değiştirmek için kimlik doğrulama gerekiyor. Hatalı değerler bilgisayarın açılmasını engelleyebilir.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/legion-firmware-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.legion-power-manager.lighting.write">
    <description>Change the keyboard lighting via Legion Power Manager</description>
    <description xml:lang="tr">Legion Power Manager ile klavye aydınlatmasını değiştir</description>
    <message>Authentication is required to change the keyboard lighting (only needed while the udev rule is not applied)</message>
    <message xml:lang="tr">Klavye aydınlatmasını değiştirmek için kimlik doğrulama gerekiyor (yalnızca udev kuralı henüz uygulanmamışken)</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/lighting-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
