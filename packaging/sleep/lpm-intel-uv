#!/bin/sh
# elogind system-sleep hook (same idea as intel-undervolt.elogind):
# re-apply the Intel undervolt boot profile after resume.
if [ "$1" = "post" ] && [ -f /etc/legion-power-manager/intel-uv-boot.json ]; then
	printf '%s' '{"op":"boot"}' | @LIBEXEC@/intel-uv-helper >/dev/null 2>&1
fi
exit 0
